{

	"compilerOptions": {
		"esModuleInterop": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"outDir": "dist",
		"declaration": true,
		"noEmit": true,
		"paths": {
			"~/*": [
				"./src/*"
			]
		}
	},
	"include": [
		"src",
		"*.ts"
	]
}