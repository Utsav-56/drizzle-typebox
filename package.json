{
  "name": "drizzle-typebox-generator",
  "version": "0.3.3",
  "description": "Generate Typebox schemas from Drizzle ORM schemas",
  "keywords": [
    "database",
    "drizzle",
    "mysql",
    "orm",
    "pg",
    "postgres",
    "postgresql",
    "schema",
    "sql",
    "sqlite",
    "ts",
    "typebox",
    "typescript",
    "validate",
    "validation"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "b": "bun run build",
    "typecheck": "bun x tsc --noEmit",
    "test:types": "cd tests && tsc",
    "pack": "(cd dist && bun pm pack --destination ..) && rm -f package.tgz && mv *.tgz package.tgz",
    "publish": "bun publish package.tgz",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.0",
    "@sinclair/typebox": "^0.34.8",
    "@types/node": "^18.15.10",
    "@utsav/typebox": "../typebox",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@sinclair/typebox": ">=0.34.8",
    "@utsav/typebox": "../typebox",
    "drizzle-orm": ">=0.45.2"
  }
}
